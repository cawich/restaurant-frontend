---
import Layout from '../layouts/Layout.astro';
import { getMenuCategories } from '../db/client';

const menuCategories = await getMenuCategories();
---
<Layout title="Sal y Limón | Mexican kitchen & bar" activePage="home">
  <main>

    <!-- ── HERO ── -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Mexican kitchen &amp; bar</p>
        <h1 id="hero-title">Bright food.<br /><em>Good times.</em></h1>
        <p class="hero-intro">
          Sal y Limón brings the color, flavor, and easygoing spirit of
          Mexico to the table. Come hungry. Stay a while.
        </p>
        <div class="hero-actions">
          <a class="button button-dark" href="#reserve">
            Reserve a table <span aria-hidden="true">↗</span>
          </a>
          <button class="text-link hero-menu-btn" id="hero-open-menu-btn" aria-haspopup="dialog">
            Explore the menu <span aria-hidden="true">↓</span>
          </button>
        </div>
      </div>
      <div class="hero-image-wrap">
        <img class="hero-image" src="/restaurant-interior.jpg" alt="Warmly lit tables inside Sal y Limón restaurant" />
        <div class="image-note">
          <span>01</span><span>Hecho con amor<br />since 2014</span>
        </div>
      </div>
    </section>

    <!-- ── MARQUEE ── -->
    <section class="marquee" aria-label="Sal y Limón highlights">
      <span>Hecho fresco</span><b>✳</b><span>Agave &amp; limón</span><b>✳</b>
      <span>Long lunches</span><b>✳</b><span>Hecho fresco</span>
    </section>

    <!-- ── DINING PILLARS ── -->
    <section class="dining-pillars" aria-label="Restaurant core philosophy">
      <div class="pillar-item">
        <span class="pillar-icon">🌮</span>
        <h3>Handmade Tortillas</h3>
        <p>Corn masa pressed and griddled to order for every single taco and quesabirria.</p>
      </div>
      <div class="pillar-item">
        <span class="pillar-icon">🍋</span>
        <h3>Coastal Ceviches</h3>
        <p>Wild Caribbean catch cured with Persian lime, crisp sea salt, and fresh herbs.</p>
      </div>
      <div class="pillar-item">
        <span class="pillar-icon">🍹</span>
        <h3>Agave &amp; Cocktails</h3>
        <p>100% blue agave tequilas, artisanal mezcals, and chilled seasonal fruit aguas.</p>
      </div>
      <div class="pillar-item">
        <span class="pillar-icon">🌴</span>
        <h3>Tropical Bistro</h3>
        <p>Breezy village dining in San Narciso, where friends linger and celebrate.</p>
      </div>
    </section>

    <!-- ── MENU BOOK OVERLAY ── -->
    <div class="menu-overlay" id="menu-overlay" role="dialog" aria-modal="true" aria-label="Menu book" hidden>
      <div class="menu-overlay-bg" id="menu-overlay-bg"></div>
      <div class="book-scene">
        <div class="book" id="menu-book">

          <!-- COVER -->
          <div class="book-page book-cover" id="book-cover">
            <div class="page-front cover-front">
              <div class="cover-spine"></div>
              <div class="cover-inner">
                <div class="cover-logo-wrap">
                  <img src="/sal-y-limon-logo.jpg" alt="Sal y Limón" class="cover-logo" />
                </div>
                <p class="cover-eyebrow">✳ Todo el menú ✳</p>
                <h2 class="cover-title">Sal y<br /><em>Limón</em></h2>
                <p class="cover-subtitle">Mexican kitchen &amp; bar — est. 2014</p>
                <button class="cover-open-btn" id="cover-open-btn">Open menu <span>→</span></button>
              </div>
              <div class="cover-decoration">
                <div class="deco-circle deco-1"></div>
                <div class="deco-circle deco-2"></div>
              </div>
            </div>
            <div class="page-back cover-back"></div>
          </div>

          <!-- CATEGORY PAGES -->
          {menuCategories.map((category, i) => (
            <div class={`book-page cat-page cat-page-${i}`} data-page={i + 1}>
              <div class="page-front">
                <div class="page-inner">
                  <div class="page-header">
                    <span class="page-num">{String(i + 1).padStart(2, '0')}</span>
                    <h3 class="page-category">{category.name}</h3>
                  </div>
                  <ul class="page-items">
                    {category.items.map((item) => (
                      <li class="page-item">
                        <div class="item-info">
                          <strong>{item.name}</strong>
                          <p>{item.detail}</p>
                        </div>
                        <span class="item-price">{item.price}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="page-footer-nav">
                    {i > 0 && <button class="pager pager-prev" data-dir="-1">← Prev</button>}
                    {i < menuCategories.length - 1 && <button class="pager pager-next" data-dir="1">Next →</button>}
                  </div>
                </div>
              </div>
              <div class="page-back">
                <div class="page-inner page-inner-back">
                  <div class="back-watermark">✳</div>
                </div>
              </div>
            </div>
          ))}

          <!-- BACK COVER -->
          <div class="book-page book-back-cover">
            <div class="page-front back-cover-front">
              <div class="back-cover-inner">
                <p class="back-cover-text">Hecho con amor</p>
                <p class="back-cover-sub">since 2014</p>
                <a href="tel:+5016362275" class="back-cover-cta">Reserve a table ↗</a>
              </div>
            </div>
            <div class="page-back back-cover-back"></div>
          </div>

        </div><!-- /book -->

        <!-- Click zones -->
        <button class="book-zone book-zone-prev" id="zone-prev" aria-label="Previous page">
          <span class="zone-arrow zone-arrow-left">&#8592;</span>
        </button>
        <button class="book-zone book-zone-next" id="zone-next" aria-label="Next page">
          <span class="zone-arrow zone-arrow-right">&#8594;</span>
        </button>
      </div><!-- /book-scene -->

      <button class="menu-close-btn" id="menu-close-btn" aria-label="Close menu">
        <span></span><span></span>
      </button>
      <p class="book-hint" id="book-hint">← tap sides to flip &nbsp;·&nbsp; esc to close →</p>
      <div class="book-pagination" id="book-pagination" aria-hidden="true">
        <span class="dot dot-active" data-page="0"></span>
        {menuCategories.map((_, i) => (
          <span class="dot" data-page={i + 1}></span>
        ))}
        <span class="dot" data-page={menuCategories.length + 1}></span>
      </div>
    </div>

    <!-- ── STORY ── -->
    <section class="story-section" id="story">
      <div class="story-image">
        <img src="/restaurant-sign.jpg" alt="Sal y Limón restaurant sign" />
      </div>
      <div class="story-copy">
        <p class="eyebrow"><span></span> De nuestra cocina</p>
        <h2>Come hungry.<br /><em>Leave happy.</em></h2>
        <p>
          We cook bright, generous Mexican food made for passing around
          the table. Fresh salsas, slow-cooked favorites, and a little
          something sweet at the end.
        </p>
        <a class="text-link" href="/menu">See the full menu <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <!-- ── REVIEWS & SOCIAL PROOF ── -->
    <section class="reviews-section" id="reviews" aria-labelledby="reviews-title">
      <div class="reviews-header">
        <p class="eyebrow" style="justify-content:center"><span></span> Google Reviews</p>
        <h2 id="reviews-title">Loved by locals.<br /><em>Remembered by travelers.</em></h2>
        <div class="overall-rating-badge">
          <svg class="google-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <span class="stars">★★★★★</span>
          <span class="rating-count">Verified Google Reviews</span>
        </div>
      </div>

      <!-- Live Elfsight Google Reviews Widget Hook -->
      <script src="https://static.elfsight.com/platform/platform.js" async></script>
      <div class="elfsight-app-google-reviews" data-elfsight-app-lazy></div>

      <!-- Direct Google Maps Review Card -->
      <div class="google-live-card">
        <div class="google-live-inner">
          <div class="google-live-info">
            <div class="google-branding">
              <svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
              </svg>
              <div>
                <strong>Sal y Limón on Google Maps</strong>
                <p>San Narciso Village, Corozal District, Belize</p>
              </div>
            </div>
            <div class="google-stars-display">
              <span class="stars-large">★★★★★</span>
              <span class="stars-sub">Read genuine diner feedback &amp; browse visitor photos</span>
            </div>
          </div>
          <div class="google-live-actions">
            <a
              href="https://www.google.com/maps/search/?api=1&query=18.30349,-88.50894"
              target="_blank"
              rel="noopener noreferrer"
              class="button button-dark"
              id="google-read-reviews-btn"
            >
              Read Reviews on Google Maps <span aria-hidden="true">↗</span>
            </a>
            <a
              href="https://www.google.com/maps/dir/?api=1&destination=18.30349,-88.50894"
              target="_blank"
              rel="noopener noreferrer"
              class="text-link"
            >
              Get Directions &amp; Visit <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── ATMOSPHERE / GALLERY ── -->
    <section class="gallery-section" aria-label="Restaurant photo gallery">
      <div class="gallery-header">
        <div>
          <p class="eyebrow"><span></span> Sabor &amp; Ambiente</p>
          <h2>Follow the table</h2>
        </div>
        <a
          href="https://www.instagram.com"
          target="_blank"
          rel="noopener noreferrer"
          class="instagram-handle-btn"
        >
          📷 @sal_y_limon_bz ↗
        </a>
      </div>
      <div class="gallery-grid">
        <div class="gallery-card">
          <img src="/restaurant-interior.jpg" alt="Warm bistro tables at Sal y Limón" />
          <span class="gallery-label">Bistro Tables</span>
        </div>
        <div class="gallery-card">
          <img src="/restaurant-sign.jpg" alt="Sal y Limón restaurant sign" />
          <span class="gallery-label">San Narciso Village</span>
        </div>
        <div class="gallery-card">
          <img src="/menu.jpg" alt="Signature dishes and drinks" />
          <span class="gallery-label">Hecho Fresco</span>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  /* ── HERO ── */
  .hero {
    display: grid;
    gap: 6vw;
    grid-template-columns: 0.88fr 1.12fr;
    margin: 52px auto 0;
    max-width: 1320px;
    padding: 0 5vw 105px;
  }
  .hero-copy { align-self: center; padding: 30px 0 60px; }
  .hero-intro {
    color: #69645d;
    font-size: 1.03rem;
    line-height: 1.65;
    margin: 35px 0;
    max-width: 340px;
  }
  .hero-actions { align-items: center; display: flex; gap: 26px; }
  .hero-menu-btn { background: none; border: none; cursor: pointer; padding: 0; }
  .hero-image-wrap { min-height: 590px; position: relative; }
  .hero-image { height: 100%; object-fit: cover; width: 100%; }
  .image-note {
    background: #f4eee4;
    bottom: 0; left: 0;
    display: flex;
    font-family: "DM Mono", monospace;
    font-size: 0.61rem;
    gap: 24px;
    line-height: 1.45;
    padding: 18px 20px;
    position: absolute;
    text-transform: uppercase;
  }
  .image-note span:first-child { color: #bc3c2d; }

  /* ── STORY ── */
  .story-section {
    background: #ded7cc;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .story-image { height: 620px; }
  .story-image img { height: 100%; object-fit: cover; width: 100%; }
  .story-copy {
    align-self: center;
    max-width: 480px;
    padding: 70px 8vw;
  }
  .story-copy h2 { font-size: clamp(3.2rem, 5vw, 5.4rem); margin-bottom: 30px; }
  .story-copy > p:not(.eyebrow) {
    color: #69645d;
    line-height: 1.7;
    margin: 0 0 28px;
    max-width: 330px;
  }

  /* ── DINING PILLARS ── */
  .dining-pillars {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    max-width: 1320px;
    margin: 0 auto;
    padding: 70px 5vw;
    border-bottom: 1px solid #dcd3c5;
  }
  .pillar-item { text-align: left; }
  .pillar-icon { font-size: 1.8rem; display: block; margin-bottom: 14px; }
  .pillar-item h3 {
    font-family: "Playfair Display", serif;
    font-size: 1.15rem;
    font-weight: 600;
    color: #242220;
    margin: 0 0 8px;
  }
  .pillar-item p {
    color: #69645d;
    font-size: 0.82rem;
    line-height: 1.6;
    margin: 0;
  }

  /* ── REVIEWS & SOCIAL PROOF ── */
  .reviews-section {
    background: #ede6dc;
    border-top: 1px solid #cfc5b9;
    border-bottom: 1px solid #cfc5b9;
    padding: 100px 5vw 110px;
  }
  .reviews-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 60px;
  }
  .reviews-header h2 {
    font-size: clamp(2.4rem, 4.5vw, 4.2rem);
    margin: 12px 0 18px;
  }
  .overall-rating-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #f4eee4;
    padding: 7px 16px;
    border-radius: 999px;
    border: 1px solid #dcd3c5;
    font-family: "DM Mono", monospace;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: #554e44;
  }
  .overall-rating-badge .stars { color: #f5a623; letter-spacing: 2px; }
  .overall-rating-badge .google-icon { flex-shrink: 0; }

  /* ── GOOGLE LIVE REVIEWS CARD ── */
  .elfsight-app-google-reviews {
    max-width: 1320px;
    margin: 0 auto 30px;
  }
  .google-live-card {
    max-width: 900px;
    margin: 0 auto;
    background: #f4eee4;
    border: 1px solid #d4cbbe;
    border-radius: 12px;
    padding: 36px 40px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
  }
  .google-live-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 36px;
    flex-wrap: wrap;
  }
  .google-branding {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 14px;
  }
  .google-branding strong {
    font-family: "Playfair Display", serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: #242220;
    display: block;
  }
  .google-branding p {
    font-size: 0.8rem;
    color: #69645d;
    margin: 3px 0 0;
  }
  .google-stars-display {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .stars-large {
    color: #f5a623;
    font-size: 1.2rem;
    letter-spacing: 3px;
  }
  .stars-sub {
    font-family: "DM Mono", monospace;
    font-size: 0.68rem;
    color: #797166;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .google-live-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  /* ── GALLERY SECTION ── */
  .gallery-section {
    max-width: 1320px;
    margin: 0 auto;
    padding: 90px 5vw;
  }
  .gallery-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
  }
  .gallery-header h2 {
    font-size: clamp(2.4rem, 4vw, 3.8rem);
    margin: 8px 0 0;
  }
  .instagram-handle-btn {
    border-bottom: 1px solid #242220;
    font-family: "DM Mono", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    padding-bottom: 4px;
    text-transform: uppercase;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .instagram-handle-btn:hover {
    color: #bc3c2d;
    border-color: #bc3c2d;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .gallery-card {
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    height: 380px;
  }
  .gallery-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .gallery-card:hover img { transform: scale(1.05); }
  .gallery-label {
    position: absolute;
    bottom: 16px;
    left: 16px;
    background: rgba(36, 34, 32, 0.85);
    backdrop-filter: blur(8px);
    color: #f4eee4;
    font-family: "DM Mono", monospace;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 4px;
  }

  /* ── MENU OVERLAY ── */
  .menu-overlay {
    position: fixed; inset: 0; z-index: 900;
    display: flex; align-items: center; justify-content: center; padding: 24px;
  }
  .menu-overlay[hidden] { display: none !important; }
  .menu-overlay-bg {
    position: absolute; inset: 0;
    background: rgba(18,16,14,0.88);
    backdrop-filter: blur(10px);
    opacity: 0; transition: opacity 0.5s ease;
  }
  .menu-overlay.is-open .menu-overlay-bg { opacity: 1; }

  /* ── BOOK ── */
  .book-scene {
    perspective: 1800px; position: relative; z-index: 1;
    width: min(520px, 94vw); height: min(680px, 90vh);
  }
  .book { width: 100%; height: 100%; position: relative; }
  .book-page {
    position: absolute; inset: 0;
    transform-style: preserve-3d;
    transform-origin: left center;
    transition: transform 0.75s cubic-bezier(0.645, 0.045, 0.355, 1.000);
    backface-visibility: hidden;
    pointer-events: none; z-index: 1;
  }
  .book-page.is-flipped { transform: rotateY(-180deg); pointer-events: none; z-index: 2; }
  .book-page.is-active  { pointer-events: all; z-index: 10; }
  .page-front, .page-back {
    position: absolute; inset: 0;
    backface-visibility: hidden;
    border-radius: 2px 8px 8px 2px; overflow: hidden;
  }
  .page-back { transform: rotateY(180deg); border-radius: 8px 2px 2px 8px; }

  /* Cover */
  .cover-front {
    background: linear-gradient(145deg, #2a0a04 0%, #6b1b0f 45%, #bc3c2d 100%);
    box-shadow: -4px 0 12px rgba(0,0,0,.4), 4px 0 24px rgba(0,0,0,.5), inset -3px 0 8px rgba(0,0,0,.3);
    position: relative; color: #f4eee4;
  }
  .cover-back { background: #1a0a06; box-shadow: inset -6px 0 15px rgba(0,0,0,.4); }
  .cover-spine {
    position: absolute; top: 0; left: 0; bottom: 0; width: 32px;
    background: linear-gradient(90deg, rgba(0,0,0,.45) 0%, rgba(255,255,255,.06) 60%, rgba(0,0,0,.2) 100%);
  }
  .cover-inner {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 24px 44px 28px 60px; text-align: center; overflow-y: auto;
  }
  .cover-logo-wrap {
    margin-bottom: 16px; position: relative;
    display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .cover-logo-wrap::before {
    content: ''; position: absolute; inset: -5px; border-radius: 50%;
    border: 1.5px solid rgba(245,201,122,.55);
    animation: logo-ring-spin 18s linear infinite;
  }
  .cover-logo-wrap::after {
    content: ''; position: absolute; inset: -12px; border-radius: 50%;
    border: 1px dashed rgba(245,201,122,.22);
  }
  @keyframes logo-ring-spin { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }
  .cover-logo {
    width: 90px; height: 90px; border-radius: 50%; object-fit: cover; display: block;
    border: 3px solid rgba(245,201,122,.7);
    box-shadow: 0 0 0 1px rgba(0,0,0,.3), 0 8px 28px rgba(0,0,0,.45), 0 0 40px rgba(245,201,122,.15);
    filter: saturate(1.1) contrast(1.02);
  }
  .cover-eyebrow {
