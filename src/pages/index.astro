---
const menuCategories = [
	{
		name: "Desayunos",
		items: [
			{ name: "Huevos con chaya", detail: "eggs, sauteed greens, beans, tortillas", price: "$12" },
			{ name: "Huevos rancheros", detail: "eggs, ranchera salsa, beans, avocado", price: "$13" },
			{ name: "Omelette", detail: "mushrooms, spinach, cheese, house salad", price: "$14" },
			{ name: "Waffle sandwich", detail: "waffle, bacon, egg, maple", price: "$13" },
		],
	},
	{
		name: "Tacos",
		items: [
			{ name: "Tacos de birria", detail: "slow-braised beef, onion, cilantro, consomme", price: "$18" },
			{ name: "Tacos al pastor", detail: "marinated pork, pineapple, onion, cilantro", price: "$16" },
			{ name: "Tacos de camarón", detail: "shrimp, cabbage, crema, pico de gallo", price: "$17" },
			{ name: "Quesabirria", detail: "melted cheese, birria, onion, cilantro", price: "$16" },
		],
	},
	{
		name: "Ceviches",
		items: [
			{ name: "Ceviche clásico", detail: "fresh catch, lime, onion, cilantro", price: "$17" },
			{ name: "Ceviche de camarón", detail: "shrimp, tomato, cucumber, avocado", price: "$18" },
			{ name: "Aguachile verde", detail: "shrimp, serrano, cucumber, lime", price: "$19" },
		],
	},
	{
		name: "Para compartir",
		items: [
			{ name: "Guacamole", detail: "avocado, pico de gallo, totopos", price: "$11" },
			{ name: "Nachos", detail: "beans, cheese, jalapeño, crema, salsa", price: "$15" },
			{ name: "Mariscos", detail: "fresh seafood, citrus, avocado, tostadas", price: "$20" },
		],
	},
	{
		name: "Postres & bebidas",
		items: [
			{ name: "Tres leches", detail: "house cake, whipped cream, seasonal fruit", price: "$9" },
			{ name: "Churros", detail: "cinnamon sugar, chocolate dipping sauce", price: "$8" },
			{ name: "Margarita clásica", detail: "tequila, lime, agave, salt", price: "$12" },
			{ name: "Agua fresca", detail: "seasonal fruit, lime, a little sweetness", price: "$6" },
		],
	},
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Sal y Limón is a bright Mexican kitchen serving generous food, cold drinks, and good times."
		/>
		<meta name="generator" content={Astro.generator} />
		<title>Sal y Limón | Mexican kitchen & bar</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link
			rel="preconnect"
			href="https://fonts.gstatic.com"
			crossorigin="anonymous"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="site-header">
			<a class="wordmark" href="/" aria-label="Sal y Limón home"
				><img src="/sal-y-limon-logo.jpg" alt="Sal y Limón" /></a
			>
			<nav aria-label="Main navigation">
				<a href="#full-menu">Menu</a>
				<a href="#story">Our story</a>
				<a href="#visit">Visit</a>
			</nav>
			<a class="header-booking" href="tel:+5016362275"
				>Book a table <span aria-hidden="true">↗</span></a
			>
		</header>

		<main>
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow">
						<span></span> Mexican kitchen & bar
					</p>
					<h1 id="hero-title">
						Bright food.<br /><em>Good times.</em>
					</h1>
					<p class="hero-intro">
						Sal y Limón brings the color, flavor, and easygoing spirit of
						Mexico to the table. Come hungry. Stay a while.
					</p>
					<div class="hero-actions">
						<a class="button button-dark" href="#reserve"
							>Reserve a table <span aria-hidden="true">↗</span
							></a
						>
						<a class="text-link" href="#menu"
							>Explore the menu <span aria-hidden="true">↓</span
							></a
						>
					</div>
				</div>
				<div class="hero-image-wrap">
					<img
						class="hero-image"
						src="/restaurant-interior.jpg"
						alt="Warmly lit tables inside Sal y Limón restaurant"
					/>
					<div class="image-note">
						<span>01</span><span>Hecho con amor<br />since 2014</span>
					</div>
				</div>
			</section>

			<section class="marquee" aria-label="Sal y Limón highlights">
				<span>Hecho fresco</span><b>✳</b><span>Agave & limón</span><b
					>✳</b
				><span>Long lunches</span><b>✳</b><span>Hecho fresco</span>
			</section>

			<section class="full-menu" id="full-menu" aria-labelledby="full-menu-title">
				<div class="full-menu-heading">
					<p class="eyebrow"><span></span> Todo el menú</p>
					<h2 id="full-menu-title">Eat<br /><em>well.</em></h2>
				</div>
				<div class="menu-categories">
					{menuCategories.map((category) => (
						<div class="menu-category">
							<h3>{category.name}</h3>
							{category.items.map((item) => (
								<div class="category-item">
									<div><strong>{item.name}</strong><p>{item.detail}</p></div>
									<span>{item.price}</span>
								</div>
							))}
						</div>
					))}
				</div>
			</section>

			<section class="story-section" id="story">
				<div class="story-image">
					<img
						src="/restaurant-sign.jpg"
						alt="Sal y Limón restaurant sign"
					/>
				</div>
				<div class="story-copy">
					<p class="eyebrow"><span></span> De nuestra cocina</p><h2>
						Come hungry.<br /><em>Leave happy.</em>
					</h2><p>
						We cook bright, generous Mexican food made for passing around
						the table. Fresh salsas, slow-cooked favorites, and a little
						something sweet at the end.
					</p><a class="text-link" href="#visit"
						>Encuéntranos <span aria-hidden="true">↗</span></a>
				</div>
			</section>

			<section class="location-section" id="visit" aria-labelledby="location-title">
				<div class="location-content">
					<div class="location-info">
						<p class="eyebrow"><span></span> Cómo encontrarnos</p>
						<h2 id="location-title">
							Find your way<br /><em>to our table.</em>
						</h2>
						<p class="location-description">
							We are located in San Narciso Village along the Philip Goldson Highway,
							just across from Escuela Secundaria Técnica México (ESTM).
						</p>

						<div class="location-details">
							<div class="detail-block">
								<span class="detail-title">Address</span>
								<p>
									Philip Goldson Highway, 7th Block<br />
									San Narciso Village, Corozal District, Belize<br />
									<em>(In front of Escuela Secundaria Técnica México)</em>
								</p>
							</div>

							<div class="detail-block">
								<span class="detail-title">Navigation Tip</span>
								<p>
									Turn into San Narciso Village from Philip Goldson Highway. We are situated at the corner of the 7th block on the paved road facing the high school.
								</p>
							</div>

							<div class="detail-block">
								<span class="detail-title">Hours</span>
								<p>
									Tuesday – Sunday: 11:00 AM – 10:00 PM<br />
									Monday: Closed
								</p>
							</div>
						</div>

						<div class="location-actions">
							<a
								class="button button-dark"
								href="https://www.google.com/maps/dir/?api=1&destination=18.30349,-88.50894"
								target="_blank"
								rel="noopener noreferrer"
								id="get-directions-btn"
							>
								Get Directions <span aria-hidden="true">↗</span>
							</a>
							<a
								class="text-link"
								href="https://www.google.com/maps/search/?api=1&query=18.30349,-88.50894"
								target="_blank"
								rel="noopener noreferrer"
								id="open-maps-btn"
							>
								Open in Google Maps <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>

					<div class="location-map-wrap">
						<div class="map-card">
							<iframe
								id="restaurant-google-map"
								title="Google Maps Location for Sal y Limón"
								src="https://maps.google.com/maps?q=18.30349,-88.50894&t=&z=16&ie=UTF8&iwloc=B&output=embed"
								loading="lazy"
								allowfullscreen
								referrerpolicy="no-referrer-when-downgrade"
							></iframe>
							<div class="map-overlay-badge">
								<span class="map-badge-dot"></span>
								<div>
									<strong>Sal y Limón</strong>
									<small>Philip Goldson Hwy, San Narciso</small>
								</div>
								<a
									href="https://www.google.com/maps/dir/?api=1&destination=18.30349,-88.50894"
									target="_blank"
									rel="noopener noreferrer"
									class="map-badge-link"
									aria-label="Direct navigation to Sal y Limón in Google Maps"
								>
									Navigate ↗
								</a>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="reserve" id="reserve">
				<p class="eyebrow"><span></span> Tu mesa te espera</p>
				<h2>Make a night<br /><em>of it.</em></h2>
				<a
					class="button button-light"
					href="tel:+5016362275"
					>Book a table <span aria-hidden="true">↗</span></a
				>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<a class="wordmark" href="/"><img src="/sal-y-limon-logo.jpg" alt="Sal y Limón" /></a><p>
					Mexican bistro & day club
				</p>
			</div>
			<div>
				<p class="footer-label">Find us</p><p>
					Philip Goldson Highway<br />
					7th block, San Narciso Village<br />
					In front of Escuela Secundaria Técnica Mexico High School
				</p>
				<p class="footer-directions-link">
					<a
						href="https://www.google.com/maps/dir/?api=1&destination=18.30349,-88.50894"
						target="_blank"
						rel="noopener noreferrer"
					>
						Get Google Maps Directions ↗
					</a>
				</p>
			</div>
			<div>
				<p class="footer-label">Reservations</p><p>
					<a href="tel:+5016362275">+501 636-2275</a><br />
					Reservations recommended
				</p>
			</div>
			<div>
				<p class="footer-label">Follow along</p><p>
					<a href="#instagram">Instagram ↗</a><br />
					<a href="tel:+5016362275">Call to reserve ↗</a>
				</p>
			</div>
		</footer>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}
	:global(html) {
		scroll-behavior: smooth;
	}
	:global(body) {
		margin: 0;
		background: #f4eee4;
		color: #242220;
		font-family: "DM Sans", sans-serif;
	}
	:global(a) {
		color: inherit;
		text-decoration: none;
	}
	.site-header {
		align-items: center;
		display: flex;
		justify-content: space-between;
		max-width: 1320px;
		margin: 0 auto;
		padding: 28px 5vw;
	}
	.wordmark {
		display: block;
		font-family: "Playfair Display", serif;
		font-size: 2rem;
		letter-spacing: -0.04em;
	}
	.wordmark img {
		border-radius: 999px;
		display: block;
		filter: saturate(0.92) contrast(0.9);
		height: auto;
		mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
		mix-blend-mode: multiply;
		max-width: 150px;
		object-fit: contain;
		opacity: 0.86;
		transition: opacity 0.25s ease, filter 0.25s ease;
	}
	.wordmark:hover img {
		filter: saturate(1) contrast(1);
		opacity: 1;
	}
	.wordmark span {
		font-family: "DM Mono", monospace;
		font-size: 0.5rem;
		letter-spacing: 0;
		margin-left: 3px;
		vertical-align: top;
	}
	nav {
		display: flex;
		gap: 34px;
		margin-left: 8%;
	}
	nav a,
	.header-booking,
	.eyebrow,
	.footer-label {
		font-family: "DM Mono", monospace;
		font-size: 0.67rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	nav a {
		color: #69645d;
		transition: color 0.2s ease;
	}
	nav a:hover {
		color: #bc3c2d;
	}
	.header-booking {
		border-bottom: 1px solid #242220;
		padding-bottom: 5px;
	}
	.header-booking span,
	.button span {
		margin-left: 9px;
	}
	.hero {
		display: grid;
		gap: 6vw;
		grid-template-columns: 0.88fr 1.12fr;
		margin: 52px auto 0;
		max-width: 1320px;
		padding: 0 5vw 105px;
	}
	.hero-copy {
		align-self: center;
		padding: 30px 0 60px;
	}
	.eyebrow {
		align-items: center;
		color: #bc3c2d;
		display: flex;
		gap: 10px;
		margin: 0 0 28px;
	}
	.eyebrow span {
		background: #bc3c2d;
		display: inline-block;
		height: 7px;
		width: 7px;
	}
	h1,
	h2 {
		font-family: "Playfair Display", serif;
		font-size: clamp(3.6rem, 6vw, 6.9rem);
		font-weight: 500;
		letter-spacing: -0.065em;
		line-height: 0.91;
		margin: 0;
	}
	h1 em,
	h2 em {
		color: #bc3c2d;
		font-weight: 500;
	}
	.hero-intro {
		color: #69645d;
		font-size: 1.03rem;
		line-height: 1.65;
		margin: 35px 0 35px;
		max-width: 340px;
	}
	.hero-actions {
		align-items: center;
		display: flex;
		gap: 26px;
	}
	.button {
		display: inline-flex;
		align-items: center;
		font-family: "DM Mono", monospace;
		font-size: 0.68rem;
		letter-spacing: 0.05em;
		padding: 16px 18px;
		text-transform: uppercase;
	}
	.button-dark {
		background: #242220;
		color: #f4eee4;
	}
	.button-light {
		background: #f4eee4;
		color: #242220;
		margin-top: 34px;
	}
	.text-link {
		border-bottom: 1px solid #aaa197;
		font-family: "DM Mono", monospace;
		font-size: 0.68rem;
		letter-spacing: 0.04em;
		padding-bottom: 5px;
		text-transform: uppercase;
	}
	.text-link span {
		color: #bc3c2d;
		margin-left: 8px;
	}
	.hero-image-wrap {
		min-height: 590px;
		position: relative;
	}
	.hero-image {
		height: 100%;
		object-fit: cover;
		width: 100%;
	}
	.image-note {
		background: #f4eee4;
		bottom: 0;
		display: flex;
		font-family: "DM Mono", monospace;
		font-size: 0.61rem;
		gap: 24px;
		left: 0;
		line-height: 1.45;
		padding: 18px 20px;
		position: absolute;
		text-transform: uppercase;
	}
	.image-note span:first-child {
		color: #bc3c2d;
	}
	.marquee {
		align-items: center;
		background: #bc3c2d;
		color: #f4eee4;
		display: flex;
		gap: 35px;
		justify-content: center;
		overflow: hidden;
		padding: 16px;
		white-space: nowrap;
	}
	.marquee span {
		font-family: "Playfair Display", serif;
		font-size: 1.08rem;
		font-style: italic;
	}
	.marquee b {
		font-size: 1rem;
		font-weight: 400;
	}
	.menu-section {
		display: grid;
		gap: 12vw;
		grid-template-columns: 0.8fr 1.2fr;
		margin: 0 auto;
		max-width: 1150px;
		padding: 145px 5vw 155px;
	}
	.menu-section h2,
	.story-section h2,
	.reserve h2 {
		font-size: clamp(3.2rem, 5vw, 5.4rem);
	}
	.menu-list {
		align-self: end;
	}
	.menu-item {
		align-items: center;
		border-top: 1px solid #cfc5b9;
		display: grid;
		gap: 25px;
		grid-template-columns: 35px 1fr auto;
		padding: 22px 0;
	}
	.menu-item:last-of-type {
		border-bottom: 1px solid #cfc5b9;
	}
	.menu-number,
	.menu-item p {
		color: #8b8379;
		font-family: "DM Mono", monospace;
		font-size: 0.63rem;
	}
	.menu-item h3 {
		font-family: "Playfair Display", serif;
		font-size: 1.45rem;
		font-weight: 500;
		margin: 0 0 5px;
	}
	.menu-item p {
		margin: 0;
	}
	.menu-item strong {
		font-family: "DM Mono", monospace;
		font-size: 0.75rem;
		font-weight: 400;
	}
	.menu-list > .text-link {
		display: inline-block;
		margin-top: 31px;
	}
	.full-menu {
		background: #242220;
		color: #f4eee4;
		display: grid;
		gap: 10vw;
		grid-template-columns: 0.7fr 1.3fr;
		padding: 120px max(5vw, calc((100vw - 1150px) / 2));
	}
	.full-menu .eyebrow {
		color: #e26750;
	}
	.full-menu .eyebrow span {
		background: #e26750;
	}
	.full-menu h2 {
		font-size: clamp(3.2rem, 5vw, 5.4rem);
	}
	.menu-image {
		border: 1px solid #605a53;
		display: block;
		margin-top: 38px;
		max-width: 230px;
		padding: 7px;
		width: 100%;
	}
	.menu-categories {
		display: grid;
		gap: 55px 45px;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
	.menu-category h3 {
		border-bottom: 1px solid #605a53;
		color: #e26750;
		font-family: "DM Mono", monospace;
		font-size: 0.7rem;
		font-weight: 400;
		letter-spacing: 0.08em;
		margin: 0 0 8px;
		padding-bottom: 10px;
		text-transform: uppercase;
	}
	.category-item {
		align-items: start;
		border-bottom: 1px solid #393632;
		display: flex;
		gap: 15px;
		justify-content: space-between;
		padding: 13px 0;
	}
	.category-item strong {
		font-family: "Playfair Display", serif;
		font-size: 1.08rem;
		font-weight: 500;
	}
	.category-item p {
		color: #a9a096;
		font-family: "DM Mono", monospace;
		font-size: 0.58rem;
		line-height: 1.45;
		margin: 4px 0 0;
	}
	.category-item > span {
		color: #e26750;
		font-family: "DM Mono", monospace;
		font-size: 0.65rem;
		padding-top: 2px;
		white-space: nowrap;
	}
	.story-section {
		background: #ded7cc;
		display: grid;
		grid-template-columns: 1fr 1fr;
	}
	.story-image {
		height: 620px;
	}
	.story-image img {
		height: 100%;
		object-fit: cover;
		width: 100%;
	}
	.story-copy {
		align-self: center;
		max-width: 480px;
		padding: 70px 8vw;
	}
	.story-copy h2 {
		margin-bottom: 30px;
	}
	.story-copy > p:not(.eyebrow) {
		color: #69645d;
		line-height: 1.7;
		margin: 0 0 28px;
		max-width: 330px;
	}
	.reserve {
		background: #242220;
		color: #f4eee4;
		padding: 130px 5vw 140px;
		text-align: center;
	}
	.reserve .eyebrow {
		justify-content: center;
	}
	.reserve h2 {
		font-size: clamp(4rem, 8vw, 8rem);
	}
	.location-section {
		background: #f4eee4;
		border-top: 1px solid #cfc5b9;
		margin: 0 auto;
		padding: 120px 5vw;
	}
	.location-content {
		display: grid;
		gap: 6vw;
		grid-template-columns: 1fr 1.15fr;
		margin: 0 auto;
		max-width: 1320px;
	}
	.location-info {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.location-info h2 {
		font-size: clamp(3.2rem, 5vw, 5.4rem);
	}
	.location-description {
		color: #69645d;
		font-size: 1.05rem;
		line-height: 1.65;
		margin: 24px 0 32px;
		max-width: 480px;
	}
	.location-details {
		display: flex;
		flex-direction: column;
		gap: 20px;
		margin-bottom: 36px;
	}
	.detail-block {
		border-left: 2px solid #bc3c2d;
		padding-left: 16px;
	}
	.detail-title {
		color: #bc3c2d;
		display: block;
		font-family: "DM Mono", monospace;
		font-size: 0.65rem;
		letter-spacing: 0.08em;
		margin-bottom: 4px;
		text-transform: uppercase;
	}
