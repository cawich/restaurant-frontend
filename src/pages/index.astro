  /* Back cover */
  .back-cover-front { background: linear-gradient(145deg, #bc3c2d 0%, #6b1b0f 55%, #2a0a04 100%); color: #f4eee4; }
  .back-cover-back  { background: #1a0a06; }
  .back-cover-inner { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 40px; }
  .back-cover-text  { font-family: "Playfair Display", serif; font-size: clamp(2rem,6vw,2.8rem); font-style: italic; margin: 0 0 8px; color: #f4eee4; }
  .back-cover-sub   { font-family: "DM Mono", monospace; font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(244,238,228,.55); margin: 0 0 36px; }
  .back-cover-cta   { background: #f5c97a; color: #242220; font-family: "DM Mono", monospace; font-size: 0.68rem; letter-spacing: 0.07em; padding: 13px 22px; text-transform: uppercase; transition: background 0.2s ease; text-decoration: none; }
  .back-cover-cta:hover { background: #f9d88a; }

  /* Close button */
  .menu-close-btn {
    position: fixed; top: 22px; right: 24px; z-index: 910;
    width: 46px; height: 46px;
    background: rgba(244,238,228,.1); border: 1px solid rgba(244,238,228,.22); border-radius: 50%;
    cursor: pointer; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;
    transition: background 0.2s ease;
  }
  .menu-close-btn:hover { background: rgba(244,238,228,.18); }
  .menu-close-btn span { display: block; width: 20px; height: 1.5px; background: #f4eee4; }
  .menu-close-btn span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .menu-close-btn span:last-child  { transform: translateY(-3.75px) rotate(-45deg); }

  /* Zones */
  .book-zone { position: absolute; top: 0; bottom: 0; width: 50%; background: none; border: none; cursor: pointer; z-index: 20; display: flex; align-items: center; padding: 0; }
  .book-zone-prev { left: 0; justify-content: flex-start; }
  .book-zone-next { right: 0; justify-content: flex-end; }
  .book-zone.zone-hidden { opacity: 0; pointer-events: none; }
  .zone-arrow {
    display: flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%;
    background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.14);
    color: rgba(255,255,255,.55); font-size: 1.2rem; opacity: 0;
    transition: opacity 0.25s ease, background 0.2s ease, transform 0.2s ease;
    margin: 0 16px; backdrop-filter: blur(4px);
  }
  .book-zone:hover .zone-arrow { opacity: 1; background: rgba(245,201,122,.18); border-color: rgba(245,201,122,.4); color: #f5c97a; transform: scale(1.1); }
  @keyframes zone-pulse { 0%{opacity:0} 40%{opacity:.7} 70%{opacity:.7} 100%{opacity:0} }
  .book-zone.zone-pulse .zone-arrow { animation: zone-pulse 2.2s ease forwards; }

  /* Hint + Dots */
  .book-hint {
    position: fixed; bottom: 60px; left: 50%; transform: translateX(-50%); z-index: 910;
    color: rgba(244,238,228,.4); font-family: "DM Mono", monospace; font-size: 0.58rem;
